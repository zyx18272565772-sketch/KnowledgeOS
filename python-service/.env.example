# LLM / Embedding
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
EMBEDDING_MODEL=dashscope
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# MySQL（请按本地环境填写，密码不要提交到 Git）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_knowledge_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ATTACHMENT_CACHE_TTL=3600

# Initial administrator（仅首次创建时使用）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Optional: Milvus Authentication (if enabled)
# MILVUS_USER=username
# MILVUS_PASSWORD=password

# Vector Store Selection (true for Milvus, false for FAISS)
# 默认使用 FAISS（零依赖，本地运行），需要生产级性能可切换 Milvus
USE_MILVUS=false

# Vector Store Configuration
VECTOR_STORE_PERSIST_DIR=./faiss_index
VECTOR_STORE_COLLECTION_NAME=ai_knowledge_collection
# 待审核向量缓存与线上 FAISS 分开保存
PENDING_VECTOR_DIR=./pending_vectors

# Rerank Configuration
# Rerank type: 'bge' (recommended, local), 'cohere' (requires API key), 'simple' (fallback), 'none' (disabled)
# bge 效果最好但首次需下载 ~1.1GB 模型，开发环境建议用 simple
RERANKER_TYPE=simple

# Retrieval Configuration
KNOWLEDGE_TOP_K=5
REASONING_TOP_K=3
RETRIEVAL_CANDIDATE_MULTIPLIER=3

# Optional: Cohere API Key (if using Cohere reranker)
# COHERE_API_KEY=your_cohere_api_key

# Knowledge duplicate inspection (reuses existing FAISS vectors)
DUPLICATE_TOP_K=5
DUPLICATE_COSINE_THRESHOLD=0.90
DUPLICATE_MAX_CANDIDATES=20
DUPLICATE_LLM_VERIFY=true
# 预发布巡检候选阈值略低，以覆盖关键数字不同的潜在冲突
INSPECTION_COSINE_THRESHOLD=0.80

# Text Chunking Configuration
# Chunk strategy: 'semantic' (recommended), 'recursive' (default)
CHUNK_STRATEGY=semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# Tesseract OCR Configuration
# Tesseract executable path（留空则自动检测常见安装路径）
TESSERACT_PATH=

# Temporary Files Configuration
TEMP_DIR=./temp

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
